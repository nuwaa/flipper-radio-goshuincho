App(
    appid="radio_goshuincho",
    name="Radio Goshuincho",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="radio_goshuincho_app",
    requires=["gui", "storage"],
    stack_size=8 * 1024,
    fap_category="Tools",
    sources=[
        "goshuin_stamp.c",
        "goshuin_multiband.c",
        "goshuin_themes.c",
        "goshuin_themed.c",
        "goshuin_collectible.c",
        "radio_goshuincho.c",
    ],
    fap_author="Radio Goshuincho contributors",
    fap_description="Create location stamps from receive-only Sub-GHz RSSI observations",
    fap_version="0.5.0",
)
